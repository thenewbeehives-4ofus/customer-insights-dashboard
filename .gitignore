# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Secrets
.env
.env.*
*.key

# Local data — ignore everything in data/ by default, then allowlist the
# small derived outputs that need to ship with the repo for reproducibility.
# Any raw dataset dropped into data/ (xlsx, csv, csv.gz, zip, parquet, …)
# stays untracked automatically.
data/*
!data/.gitkeep
!data/README.md
!data/customers.csv
!data/monthly.csv

# Tableau workbook artifacts (keep .twb/.twbx out unless explicitly added)
*.twb.bak
